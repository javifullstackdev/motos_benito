// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workshop {
  workshopId  Int @id @default(autoincrement()) @map("workshop_id")
  name String @unique
  streetType String @map("street_type")
  streetName String @map("street_name")
  streetNumber String @map("street_number")
  city String
  province String
  postalCode String @map("postal_code")
  country String
  phone String
  email String
  invoices Invoice[]

  @@map("workshops")
}

model Employee {
  emplId  Int  @id @default(autoincrement()) @map("empl_id")
  firstName String  @map("first_name")
  lastName1  String @map("last_name_1")
  lastName2  String  @map("last_name_2")
  nationalId  String @unique @map("national_id")
  email  String @unique
  password String
  streetType  String @map("street_type")
  streetName  String @map("street_name")
  streetNumber  String  @map("street_number")
  city String
  province String
  postalCode  String  @map("postal_code")
  country String
  active Boolean
  invoices Invoice[]

  @@map("employees")
}

model Customer {
  customerId  Int @id @default(autoincrement())  @map("customer_id")
  type  String
  taxId String @unique  @map("tax_id")
  name String
  phone  String
  email String
  streetType  String  @map("street_type")
  streetName  String  @map("street_name")
  streetNumber  String @map("street_number")
  city String
  province String
  postalCode  String @map("postal_code")
  country  String
  invoices Invoice[]

  @@map("customers")
}

model Item {
  itemId Int @id @default(autoincrement())  @map("item_id")
  name String @unique
  unitPrice Decimal @db.Decimal(10,2) @map("unit_price")
  inStock  Boolean  @map("in_stock")
  invoiceLines InvoiceLine[]

  @@map("items")
}

model Invoice {
  invoiceId  Int @id @default(autoincrement())  @map("invoice_id")
  invoiceNumber String @unique @map("invoice_number")
  workshopId Int  @map("workshop_id")
  emplId Int  @map("empl_id")
  customerId  Int  @map("customer_id")
  issueDate DateTime  @default(now()) @map("issue_date")
  subtotal  Decimal @db.Decimal(10,2)
  taxRate  Decimal @db.Decimal(10,2)  @map("tax_rate")
  taxAmount Decimal @db.Decimal(10,2)  @map("tax_amount")
  total Decimal @db.Decimal(10,2)
  currentHash String @unique @map("current_hash")
  previousHash String @map("previous_hash")
  status  String
  correctedInvoiceId  Int?  @map("corrected_invoice_id")
  workshop Workshop @relation(fields: [workshopId], references: [workshopId])
  employee Employee @relation(fields: [emplId], references: [emplId])
  customer Customer @relation(fields: [customerId], references: [customerId])
  invoiceLines InvoiceLine[]

  @@map("invoices")
}

model InvoiceLine {
  invoiceLineId  Int @id @default(autoincrement())  @map("invoice_line_id")
  invoiceId Int  @map("invoice_id")
  itemId Int  @map("item_id")
  description String
  quantity  Int
  unitPrice Decimal @db.Decimal(10,2)  @map("unit_price")
  lineSubtotal  Decimal @db.Decimal(10,2)  @map("line_subtotal")
  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId])
  item Item @relation(fields: [itemId], references: [itemId])

  @@map("invoice_lines")
}
